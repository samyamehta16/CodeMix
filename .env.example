# Copy this file to .env and fill in your own key. Never commit the real
# .env (it's already in .gitignore) or paste a real key into this example
# file - keep this one a placeholder.
GEMINI_API_KEY=your_gemini_api_key_here

# Free-tier model. Check https://ai.google.dev/gemini-api/docs/models for
# the current free-tier model name/limits before running at scale.
# (gemini-2.0-flash's free tier has since dropped to 0 quota for some keys;
# gemini-flash-lite-latest / gemini-flash-latest were confirmed working.)
GEMINI_MODEL=gemini-flash-lite-latest

# Free tier is rate-limited (requests per minute). Keep this conservative
# so the script doesn't get throttled/blocked mid-run.
REQUESTS_PER_MINUTE=12

# --- Evidence-Aware Fake News Detection pipeline (src/verification/) ---
# Web search provider for evidence retrieval. Only "serper" is actually
# implemented right now (src/verification/web_search.py) - the interface
# is provider-agnostic so more can be added later without touching other
# modules.
SEARCH_PROVIDER=serper

# Get a free key at https://serper.dev (2,500 free one-time queries, no
# credit card required).
SERPER_API_KEY=ef81961b2d8e6d6e2828a8740e14210d7c9e49e6
